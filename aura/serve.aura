; 听在 0.0.0.0 上的开关课。真值是工作区里的七个字面量，浏览器只预览。
; 启动时 set-code 装上 aura/board-seed.aura。之后每次改动是一次
; mutate:replace-value，不把孩子贴来的正文再 set-code 进去。
; GET / 开关课，GET /catalog.json 课程名册，GET /web 里的单层 .html 和 .js。
; GET /api/state，POST /api 一行命令或一段 (define ...)。
; 分数课是 GET /api/fractions/state 和 POST /api/fractions。换页时换工作区。
; string-length 按码点计，HTTP 的 Content-Length 按字节计。

(require "std/socket" all:)
(require "aura/bits" all:)
(require "aura/board" all:)
(require "aura/fractions" all:)

(define *note* "")
(define *mut* "")
(define *page* "")
(define *catalog* "")
(define *live* "runtime/live.aura")
(define *port-file* "runtime/port")
(define *runtime* "runtime")
(define *lesson* "switches")

(define (serve:env name default)
  (let ((v (getenv name)))
    (if (and (string? v) (> (string-length v) 0)) v default)))

(define (serve:port)
  (let ((n (string->number (serve:env "GUOGUO_PORT" "8765") 10)))
    (if (and (integer? n) (>= n 0) (<= n 65535)) n 8765)))

; 默认每块网卡都听。本机仍可用 127.0.0.1。另一台电脑用这台机器的地址。
; GUOGUO_BIND=127.0.0.1 可以收回到回环。地址必须是 IPv4 数字。
(define (serve:bind)
  (serve:env "GUOGUO_BIND" "0.0.0.0"))

(define (serve:cat parts)
  (let ((out "") (p parts))
    (while (lambda () (pair? p))
      (lambda ()
        (set! out (string-append out (car p)))
        (set! p (cdr p))))
    out))

(define (serve:utf8-len s)
  (let ((n (string-length s)) (i 0) (b 0))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (set! b (+ b (cond ((< c 128) 1) ((< c 2048) 2) ((< c 65536) 3) (#t 4))))
          (set! i (+ i 1)))))
    b))

(define (serve:take-bytes s nbytes)
  (let ((n (string-length s)) (i 0) (b 0) (stop #f))
    (while (lambda () (and (not stop) (< i n) (< b nbytes)))
      (lambda ()
        (let ((c (string-ref s i)))
          (let ((nb (cond ((< c 128) 1) ((< c 2048) 2) ((< c 65536) 3) (#t 4))))
            (if (> (+ b nb) nbytes)
              (set! stop #t)
              (begin (set! b (+ b nb)) (set! i (+ i 1))))))))
    (if (= i 0) "" (substring s 0 i))))

(define (serve:find-cl head)
  (let ((a (string-index head "Content-Length:" 0)))
    (if (>= a 0) a
      (let ((b (string-index head "content-length:" 0)))
        (if (>= b 0) b -1)))))

(define (serve:content-length buf header-end)
  (let ((head (substring buf 0 header-end)))
    (let ((p (serve:find-cl head)))
      (if (< p 0) 0
        (let ((i (+ p 15)) (n (string-length head)) (num ""))
          (while (lambda () (and (< i n)
                                 (or (= (string-ref head i) 32) (= (string-ref head i) 9))))
            (lambda () (set! i (+ i 1))))
          (while (lambda () (and (< i n)
                                 (>= (string-ref head i) 48)
                                 (<= (string-ref head i) 57)))
            (lambda ()
              (set! num (string-append num (list->string (list (string-ref head i)))))
              (set! i (+ i 1))))
          (let ((v (if (equal? num "") #f (string->number num 10))))
            (if (integer? v) v 0)))))))

(define (serve:header-end buf) (string-index buf "\r\n\r\n" 0))

(define (serve:complete? buf)
  (let ((h (serve:header-end buf)))
    (if (< h 0) #f
      (let ((need (serve:content-length buf h))
            (rest (substring buf (+ h 4) (string-length buf))))
        (>= (serve:utf8-len rest) need)))))

(define (serve:read sock)
  (let ((buf "") (done #f) (guard 0))
    (while (lambda () (and (not done) (< guard 8)))
      (lambda ()
        (set! guard (+ guard 1))
        (if (serve:complete? (serve:skip-blank buf))
          (set! done #t)
          (let ((chunk (tcp-recv sock 65536)))
            (if (and (string? chunk) (> (string-length chunk) 0))
              (set! buf (string-append buf chunk))
              (set! done #t))))))
    (serve:skip-blank buf)))

(define (serve:first-line req)
  (let ((p (string-index req "\r\n" 0)))
    (if (< p 0) req (substring req 0 p))))

(define (serve:method line)
  (let ((p (string-index line " " 0)))
    (if (< p 0) "" (substring line 0 p))))

(define (serve:path line)
  (let ((p (string-index line " " 0)))
    (if (< p 0) "/"
      (let ((rest (substring line (+ p 1) (string-length line))))
        (let ((q (string-index rest " " 0)))
          (let ((path (if (< q 0) rest (substring rest 0 q))))
            (let ((h (string-index path "?" 0)))
              (if (< h 0) path (substring path 0 h)))))))))

(define (serve:body req)
  (let ((h (serve:header-end req)))
    (if (< h 0) ""
      (let ((need (serve:content-length req h))
            (rest (substring req (+ h 4) (string-length req))))
        (if (<= need 0) "" (serve:take-bytes rest need))))))

(define (serve:send-all sock data)
  (let ((n (string-length data)) (i 0) (ok #t))
    (while (lambda () (and ok (< i n)))
      (lambda ()
        (let ((j i) (bytes 0) (stop #f))
          (while (lambda () (and (not stop) (< j n) (< bytes 4096)))
            (lambda ()
              (let ((c (string-ref data j)))
                (let ((nb (cond ((< c 128) 1) ((< c 2048) 2) ((< c 65536) 3) (#t 4))))
                  (if (and (> bytes 0) (> (+ bytes nb) 4096))
                    (set! stop #t)
                    (begin (set! bytes (+ bytes nb)) (set! j (+ j 1))))))))
          (let ((sent (tcp-send sock (substring data i j))))
            (if (and (integer? sent) (= sent bytes))
              (set! i j)
              (set! ok #f))))))
    ok))

(define (serve:ends-with? s suf)
  (let ((n (string-length s)) (m (string-length suf)))
    (if (or (< m 1) (< n m)) #f
      (string=? (substring s (- n m) n) suf))))

(define (serve:web-char c)
  (or (and (>= c 48) (<= c 57))
      (and (>= c 65) (<= c 90))
      (and (>= c 97) (<= c 122))
      (= c 45) (= c 46) (= c 95)))

(define (serve:web-rel path)
  (if (or (< (string-length path) 2) (not (= (string-ref path 0) 47)))
    #f
    (let ((rel (substring path 1 (string-length path)))
          (n 0) (i 0) (ok #t))
      (set! n (string-length rel))
      (if (or (< n 1) (> n 64) (>= (string-index rel ".." 0) 0))
        #f
        (begin
          (while (lambda () (and ok (< i n)))
            (lambda ()
              (if (serve:web-char (string-ref rel i))
                (set! i (+ i 1))
                (set! ok #f))))
          (if ok rel #f))))))

(define (serve:static path)
  (let ((rel (serve:web-rel path)))
    (if (not (string? rel))
      #f
      (let ((type (cond
                    ((serve:ends-with? rel ".html") "text/html; charset=utf-8")
                    ((serve:ends-with? rel ".js") "text/javascript; charset=utf-8")
                    (#t #f))))
        (if (not (string? type))
          #f
          (let ((body (read-file (string-append "web/" rel))))
            (if (string? body) (list type body) #f)))))))

(define (serve:respond sock status type body)
  (let ((head (serve:cat (list
                "HTTP/1.1 " status "\r\n"
                "Content-Type: " type "\r\n"
                "Content-Length: " (number->string (serve:utf8-len body)) "\r\n"
                "Connection: close\r\n"
                "Cache-Control: no-store\r\n"
                "\r\n"))))
    (if (not (serve:send-all sock (string-append head body)))
      (display "发送中断\n"))))

(define (serve:bind-live)
  (set! *live* (string-append *runtime*
                              (if (equal? *lesson* "fractions")
                                "/fractions.aura"
                                "/live.aura"))))

(define (serve:view st ok? err)
  (if (equal? *lesson* "fractions")
    (fr:json-view st ok? err *note*
                  (fr:pretty (current-source :workspace))
                  (current-source :workspace)
                  *mut*
                  (fr:snapshot))
    (bits:json-view st ok? err *note*
                    (board:pretty (current-source :workspace))
                    (current-source :workspace)
                    *mut*
                    (board:snapshot))))

(define (serve:answer sock r)
  (let ((st (bits:result r)))
    (if (not (pair? st))
      (serve:respond sock "500 Internal Server Error" "text/plain; charset=utf-8"
                     "工作区读不出来\n")
      (serve:respond sock "200 OK" "application/json; charset=utf-8"
                     (serve:view st (bits:ok? r) (bits:error r))))))

(define (serve:read-now)
  (if (equal? *lesson* "fractions") (fr:state) (board:state)))

(define (serve:run-command now text)
  (if (equal? *lesson* "fractions")
    (fr:command now text)
    (bits:command now text)))

(define (serve:commit r)
  (set! *mut* "")
  (if (equal? *lesson* "fractions")
    (fr:forget-touch!)
    (board:forget-touch!))
  (if (not (bits:ok? r))
    r
    (let ((wrote (if (equal? *lesson* "fractions")
                   (fr:commit! (bits:result r))
                   (board:commit! (bits:result r)))))
      (cond
        ((equal? wrote #f)
         (let ((live (serve:read-now)))
           (bits:fail "工作区没有改成" (if (pair? live) live (bits:result r)))))
        ((equal? wrote "") r)
        (#t
         (set! *mut* wrote)
         (set! *note* "")
         (write-file *live* (current-source :workspace))
         (let ((live (serve:read-now)))
           (if (pair? live) (bits:ok live) (bits:fail "工作区读不出来" (bits:result r)))))))))

(define (serve:reload now)
  (let ((text (read-file *live*)))
    (if (string? text)
      (serve:run-command now text)
      (bits:fail "还没有保存的程序" now))))

(define (serve:restore-saved bad-note)
  (let ((now (serve:read-now)) (prev (read-file *live*)))
    (if (not (pair? now))
      #f
      (if (not (string? prev))
        (begin (write-file *live* (current-source :workspace)) #t)
        (let ((r (serve:run-command now prev)))
          (if (not (bits:ok? r))
            (begin (set! *note* bad-note) #t)
            (let ((wrote (if (equal? *lesson* "fractions")
                           (fr:commit! (bits:result r))
                           (board:commit! (bits:result r)))))
              (if (equal? wrote #f)
                (begin (set! *note* bad-note) #t)
                (begin
                  (if (not (equal? wrote ""))
                    (begin
                      (set! *mut* wrote)
                      (write-file *live* (current-source :workspace))))
                  #t)))))))))

(define (serve:ensure lesson)
  (if (equal? *lesson* lesson)
    #t
    (begin
      (write-file *live* (current-source :workspace))
      (set! *note* "")
      (set! *mut* "")
      (if (equal? lesson "fractions")
        (if (not (equal? (fr:install! "aura/fraction-seed.aura") #t))
          #f
          (begin
            (set! *lesson* "fractions")
            (serve:bind-live)
            (serve:restore-saved "上次保存的分数读不懂，先用新的分数。再动一次才会覆盖那个文件。")))
        (if (not (equal? (board:install! "aura/board-seed.aura") #t))
          #f
          (begin
            (set! *lesson* "switches")
            (serve:bind-live)
            (serve:restore-saved "上次保存的程序读不懂，先用新的开关。再动一次才会覆盖那个文件。")))))))

(define (serve:post sock req lesson)
  (if (not (serve:ensure lesson))
    (serve:respond sock "500 Internal Server Error" "text/plain; charset=utf-8"
                   "工作区换不过去\n")
    (let ((body (serve:body req)) (now (serve:read-now)))
      (if (not (pair? now))
        (serve:respond sock "500 Internal Server Error" "text/plain; charset=utf-8"
                       "工作区读不出来\n")
        (if (> (string-length body) 20000)
          (serve:respond sock "400 Bad Request" "text/plain; charset=utf-8" "太长了\n")
          (let ((r (if (equal? (bits:trim body) "reload")
                     (serve:reload now)
                     (serve:run-command now body))))
            (serve:answer sock (serve:commit r))))))))

; 有的请求前面会先来一个空行。空行不是一页，丢掉再认路径。
(define (serve:skip-blank s)
  (if (and (>= (string-length s) 2)
           (= (string-ref s 0) 13)
           (= (string-ref s 1) 10))
    (serve:skip-blank (substring s 2 (string-length s)))
    s))

(define (serve:handle sock)
  (let ((req (serve:skip-blank (serve:read sock))))
    (if (or (not (string? req)) (= (string-length req) 0))
      #t
      (let ((line (serve:first-line req)))
        (let ((method (serve:method line)) (path (serve:path line)))
          (cond
            ((and (equal? method "GET")
                  (or (equal? path "/") (equal? path "/index.html")))
             (serve:respond sock "200 OK" "text/html; charset=utf-8" *page*))
            ((and (equal? method "GET") (equal? path "/api/state"))
             (if (not (serve:ensure "switches"))
               (serve:respond sock "500 Internal Server Error"
                              "text/plain; charset=utf-8" "工作区换不过去\n")
               (let ((st (board:state)))
                 (if (not (pair? st))
                   (serve:respond sock "500 Internal Server Error"
                                  "text/plain; charset=utf-8" "工作区读不出来\n")
                   (begin
                     (set! *mut* "")
                     (board:forget-touch!)
                     (serve:respond sock "200 OK" "application/json; charset=utf-8"
                                    (serve:view st #t "")))))))
            ((and (equal? method "GET") (equal? path "/api/fractions/state"))
             (if (not (serve:ensure "fractions"))
               (serve:respond sock "500 Internal Server Error"
                              "text/plain; charset=utf-8" "工作区换不过去\n")
               (let ((st (fr:state)))
                 (if (not (pair? st))
                   (serve:respond sock "500 Internal Server Error"
                                  "text/plain; charset=utf-8" "工作区读不出来\n")
                   (begin
                     (set! *mut* "")
                     (fr:forget-touch!)
                     (serve:respond sock "200 OK" "application/json; charset=utf-8"
                                    (serve:view st #t "")))))))
            ((and (equal? method "POST") (equal? path "/api"))
             (serve:post sock req "switches"))
            ((and (equal? method "POST") (equal? path "/api/fractions"))
             (serve:post sock req "fractions"))
            ((and (equal? method "GET") (equal? path "/catalog.json"))
             (serve:respond sock "200 OK" "application/json; charset=utf-8" *catalog*))
            ((equal? method "GET")
             (let ((file (serve:static path)))
               (if (pair? file)
                 (serve:respond sock "200 OK" (car file) (car (cdr file)))
                 (serve:respond sock "404 Not Found" "text/plain; charset=utf-8"
                                "没有这一页\n"))))
            (#t
             (serve:respond sock "404 Not Found" "text/plain; charset=utf-8"
               "没有这一页\n"))))))))

(define (serve:loop listener)
  (while (lambda () #t)
    (lambda ()
      (let ((client (tcp-accept listener)))
        (if (integer? client)
          (begin
            (serve:handle client)
            (tcp-close client)))))))

(define (serve:boot)
  (let ((want (serve:env "GUOGUO_LESSON" "switches")))
    (set! *lesson* (if (equal? want "fractions") "fractions" "switches")))
  (serve:bind-live)
  (if (equal? *lesson* "fractions")
    (if (not (equal? (fr:install! "aura/fraction-seed.aura") #t))
      (begin
        (display "装不上分数工作区。请在 guoguo 仓库根目录运行。\n")
        (exit 1))
      (if (not (serve:restore-saved "上次保存的分数读不懂，先用新的分数。再动一次才会覆盖那个文件。"))
        (begin (display "工作区里的分数读不出来。\n") (exit 1))))
    (if (not (equal? (board:install! "aura/board-seed.aura") #t))
      (begin
        (display "装不上开关工作区。请在 guoguo 仓库根目录运行。\n")
        (exit 1))
      (if (not (serve:restore-saved "上次保存的程序读不懂，先用新的开关。再动一次才会覆盖那个文件。"))
        (begin (display "工作区里的开关读不出来。\n") (exit 1))))))

(define (serve:start)
  (set! *page* (read-file "web/index.html"))
  (set! *catalog* (read-file "courses/catalog.json"))
  (if (or (not (string? *page*)) (not (string? *catalog*)))
    (begin
      (display "找不到 web/index.html 或 courses/catalog.json，请在 guoguo 仓库根目录运行。\n")
      (exit 1)))
  (set! *runtime* (serve:env "GUOGUO_RUNTIME" "runtime"))
  (set! *port-file* (string-append *runtime* "/port"))
  (serve:boot)
  (let ((listener (tcp-listen (serve:port) (serve:bind))))
    (if (not (integer? listener))
      (begin
        (display "端口打不开。换一个 GUOGUO_PORT，或检查 GUOGUO_BIND 是不是 IPv4 数字。\n")
        (exit 1))
      (let ((port (tcp-local-port listener)))
        (if (not (integer? port))
          (begin (display "不知道端口。\n") (exit 1))
          (begin
            (write-file *port-file* (string-append (number->string port) "\n"))
            (display (serve:cat (list
                       "果果的课已经打开，听在 " (serve:bind) ":" (number->string port) "\n"
                       "本机 http://127.0.0.1:" (number->string port) "\n"
                       "开关课第 2 课 http://127.0.0.1:" (number->string port) "/?lesson=2\n"
                       "分数课 http://127.0.0.1:" (number->string port) "/fractions.html\n"
                       "全部课程 http://127.0.0.1:" (number->string port) "/courses.html\n"
                       "另一台电脑用这台机器的地址，不要用那台电脑自己的 127.0.0.1。\n"
                       "按 Ctrl+C 结束\n")))
            (serve:loop listener)))))))

(serve:start)
