; 果果的开关课 — 位是真的，画面只是在读它们。
; state 是一张表：(lamp width value red green blue rows)
; lamp 是 0 或 1。width 是 4、5 或 8。value 放得进这么多位。
; red / green / blue 和 rows 里的每一行都是 0 到 255。
; 卡片从左到右，下标 0 是最高位。

(export bits:fresh bits:command bits:ok bits:fail bits:ok? bits:error bits:result
        bits:source bits:json bits:json-view bits:hex bits:oct bits:from-int
        bits:letter bits:lamp bits:width bits:value bits:red bits:green
        bits:blue bits:rows bits:nth bits:hex-grouped bits:oct-grouped
        bits:trim bits:field bits:apply-fields bits:reverse bits:cat)

(define (bits:ok state) (list #t "" state))
(define (bits:fail msg state) (list #f msg state))
(define (bits:ok? r) (equal? (car r) #t))
(define (bits:error r) (bits:nth r 1))
(define (bits:result r) (bits:nth r 2))

(define (bits:stamp-rows name)
  (cond
    ((equal? name "smile") (list 60 66 165 129 165 153 66 60))
    ((equal? name "heart") (list 102 255 255 255 126 60 24 0))
    ((equal? name "a") (list 24 36 66 126 66 66 66 0))
    ((equal? name "clear") (list 0 0 0 0 0 0 0 0))
    (#t #f)))

(define (bits:fresh)
  (list 1 5 11 255 0 0 (bits:stamp-rows "smile")))

(define (bits:nth xs i)
  (let ((k i) (p xs))
    (while (lambda () (and (> k 0) (pair? p)))
      (lambda ()
        (set! p (cdr p))
        (set! k (- k 1))))
    (if (and (pair? p) (= k 0)) (car p) #f)))

(define (bits:list-length xs)
  (let ((n 0) (p xs))
    (while (lambda () (pair? p))
      (lambda ()
        (set! n (+ n 1))
        (set! p (cdr p))))
    n))

(define (bits:reverse xs)
  (let ((out (list)) (p xs))
    (while (lambda () (pair? p))
      (lambda ()
        (set! out (cons (car p) out))
        (set! p (cdr p))))
    out))

(define (bits:set-nth xs i v)
  (let ((out (list)) (k 0) (p xs))
    (while (lambda () (pair? p))
      (lambda ()
        (set! out (cons (if (= k i) v (car p)) out))
        (set! p (cdr p))
        (set! k (+ k 1))))
    (bits:reverse out)))

(define (bits:lamp s) (bits:nth s 0))
(define (bits:width s) (bits:nth s 1))
(define (bits:value s) (bits:nth s 2))
(define (bits:red s) (bits:nth s 3))
(define (bits:green s) (bits:nth s 4))
(define (bits:blue s) (bits:nth s 5))
(define (bits:rows s) (bits:nth s 6))

(define (bits:copy s lamp width value red green blue rows)
  (list
    (if (equal? lamp #f) (bits:lamp s) lamp)
    (if (equal? width #f) (bits:width s) width)
    (if (equal? value #f) (bits:value s) value)
    (if (equal? red #f) (bits:red s) red)
    (if (equal? green #f) (bits:green s) green)
    (if (equal? blue #f) (bits:blue s) blue)
    (if (equal? rows #f) (bits:rows s) rows)))

(define (bits:cat parts)
  (let ((out "") (p parts))
    (while (lambda () (pair? p))
      (lambda ()
        (set! out (string-append out (car p)))
        (set! p (cdr p))))
    out))

(define (bits:join xs sep)
  (let ((out "") (p xs) (first #t))
    (while (lambda () (pair? p))
      (lambda ()
        (if first
          (begin (set! out (car p)) (set! first #f))
          (set! out (bits:cat (list out sep (car p)))))
        (set! p (cdr p))))
    out))

(define (bits:ch c) (list->string (list c)))

(define (bits:space? c)
  (or (= c 32) (= c 9) (= c 10) (= c 13)))

(define (bits:trim s)
  (let ((n (string-length s)) (lo 0) (hi n))
    (while (lambda () (and (< lo hi) (bits:space? (string-ref s lo))))
      (lambda () (set! lo (+ lo 1))))
    (while (lambda () (and (< lo hi) (bits:space? (string-ref s (- hi 1)))))
      (lambda () (set! hi (- hi 1))))
    (if (< lo hi) (substring s lo hi) "")))

(define (bits:starts-with? s p)
  (let ((n (string-length p)))
    (and (>= (string-length s) n) (equal? (substring s 0 n) p))))

(define (bits:strip-chars s drop)
  (let ((n (string-length s)) (i 0) (out ""))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (< (string-index drop (bits:ch c) 0) 0)
            (set! out (string-append out (bits:ch c))))
          (set! i (+ i 1)))))
    out))

(define (bits:strip-spaces s) (bits:strip-chars s " \t\r\n"))

(define (bits:downcase s)
  (let ((n (string-length s)) (i 0) (out ""))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (and (>= c 65) (<= c 90))
            (set! out (string-append out (bits:ch (+ c 32))))
            (set! out (string-append out (bits:ch c))))
          (set! i (+ i 1)))))
    out))

(define (bits:upcase s)
  (let ((n (string-length s)) (i 0) (out ""))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (and (>= c 97) (<= c 122))
            (set! out (string-append out (bits:ch (- c 32))))
            (set! out (string-append out (bits:ch c))))
          (set! i (+ i 1)))))
    out))

(define (bits:strip-hex s)
  (let ((t (bits:downcase (bits:strip-chars s "# \t\r\n"))))
    (if (bits:starts-with? t "0x") (substring t 2 (string-length t)) t)))

(define (bits:only-bits? s)
  (let ((n (string-length s)) (i 0) (ok #t))
    (while (lambda () (and ok (< i n)))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (or (= c 48) (= c 49))
            (set! i (+ i 1))
            (set! ok #f)))))
    (and ok (> n 0))))

(define (bits:pad-left s width ch)
  (let ((out s))
    (while (lambda () (< (string-length out) width))
      (lambda () (set! out (string-append ch out))))
    (if (> (string-length out) width)
      (substring out (- (string-length out) width) (string-length out))
      out)))

(define (bits:pow2 k)
  (let ((p 1) (i 0))
    (while (lambda () (< i k))
      (lambda ()
        (set! p (* p 2))
        (set! i (+ i 1))))
    p))

(define (bits:from-int n width)
  (bits:pad-left (number->string n 2) width "0"))

(define (bits:hex-digits width) (if (= width 4) 1 2))
(define (bits:oct-digits width) (if (= width 8) 3 2))

(define (bits:hex n width)
  (bits:upcase (bits:pad-left (number->string n 16) (bits:hex-digits width) "0")))

(define (bits:oct n width)
  (bits:pad-left (number->string n 8) (bits:oct-digits width) "0"))

(define (bits:letter n)
  (if (and (>= n 32) (<= n 126)) (bits:ch n) ""))

(define (bits:letter-note n width)
  (cond
    ((and (>= n 65) (<= n 90))
     (bits:cat (list "大写字母 " (bits:letter n) "，编号 " (number->string n))))
    ((and (>= n 97) (<= n 122))
     (bits:cat (list "小写字母 " (bits:letter n) "，编号 " (number->string n))))
    ((and (>= n 48) (<= n 57))
     (bits:cat (list "数字字符 " (bits:letter n) "，编号 " (number->string n))))
    ((= n 32) "空格，编号 32")
    ((and (>= n 32) (<= n 126))
     (bits:cat (list "符号 " (bits:letter n) "，编号 " (number->string n))))
    ((< width 8) "字母通常要一个字节。点「一个字节」，再写 A。")
    (#t (bits:cat (list "编号 " (number->string n) " 还不是一个能看见的字母")))))

(define (bits:group-digit g radix)
  (bits:upcase (number->string (string->number g 2) radix)))

(define (bits:groups-right s size)
  (let ((n (string-length s)) (i n) (groups (list)) (digits (list))
        (radix (if (= size 3) 8 16)))
    (while (lambda () (> i 0))
      (lambda ()
        (let ((lo (if (< (- i size) 0) 0 (- i size))))
          (let ((g (substring s lo i)))
            (set! groups (cons g groups))
            (set! digits (cons (bits:group-digit g radix) digits))
            (set! i lo)))))
    (cons groups digits)))

(define (bits:hex-grouped n width)
  (bits:join (car (bits:groups-right (bits:from-int n width) 4)) " "))

(define (bits:oct-grouped n width)
  (bits:join (car (bits:groups-right (bits:from-int n width) 3)) " "))

(define (bits:widen width n)
  (cond
    ((or (< n 0) (> n 255)) #f)
    ((< n 16) (if (< width 4) 4 width))
    ((< n 32) (if (< width 5) 5 width))
    (#t 8)))

(define (bits:put state width value)
  (if (or (< value 0) (>= value (bits:pow2 width)))
    (bits:fail "这个数用这么少的卡片放不下" state)
    (bits:ok (bits:copy state #f width value #f #f #f #f))))

(define (bits:set-number state n)
  (if (or (not (integer? n)) (< n 0) (> n 255))
    (bits:fail "写一个 0 到 255 的整数" state)
    (bits:put state (bits:widen (bits:width state) n) n)))

(define (bits:set-width state w)
  (if (not (or (= w 4) (= w 5) (= w 8)))
    (bits:fail "宽度只能是 4、5 或 8" state)
    (if (>= (bits:value state) (bits:pow2 w))
      (bits:fail "这个数用这么少的卡片放不下" state)
      (bits:ok (bits:copy state #f w #f #f #f #f #f)))))

(define (bits:width-for-len n)
  (cond
    ((and (>= n 1) (<= n 4)) 4)
    ((= n 5) 5)
    ((and (>= n 6) (<= n 8)) 8)
    (#t #f)))

(define (bits:flip-bit n width index)
  (if (or (< index 0) (>= index width))
    #f
    (let ((s (bits:from-int n width))
          (place (bits:pow2 (- (- width 1) index))))
      (if (= (string-ref s index) 49) (- n place) (+ n place)))))

(define (bits:nat s radix)
  (if (equal? s "")
    #f
    (let ((n (string->number s radix)))
      (if (integer? n) n #f))))

(define (bits:words s)
  (let ((n (string-length s)) (i 0) (out (list)) (cur ""))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (if (bits:space? c)
            (begin
              (if (> (string-length cur) 0)
                (begin (set! out (cons cur out)) (set! cur "")))
              (set! i (+ i 1)))
            (begin
              (set! cur (string-append cur (bits:ch c)))
              (set! i (+ i 1)))))))
    (if (> (string-length cur) 0) (set! out (cons cur out)))
    (bits:reverse out)))

(define (bits:word words i)
  (let ((v (bits:nth words i)))
    (if (string? v) v "")))

(define (bits:join-from words i)
  (let ((out "") (k i) (n (bits:list-length words)))
    (while (lambda () (< k n))
      (lambda ()
        (set! out (string-append out (bits:word words k)))
        (set! k (+ k 1))))
    out))

(define (bits:set-bin state raw)
  (let ((s (bits:strip-spaces raw)))
    (cond
      ((= (string-length s) 0) (bits:fail "写几个 0 和 1" state))
      ((> (string-length s) 8) (bits:fail "一个字节只有 8 个开关" state))
      ((not (bits:only-bits? s)) (bits:fail "二进制只能写 0 和 1" state))
      (#t
       (let ((w (bits:width-for-len (string-length s))))
         (bits:put state w (string->number (bits:pad-left s w "0") 2)))))))

(define (bits:set-hex state raw)
  (let ((t (bits:strip-hex raw)))
    (cond
      ((= (string-length t) 0) (bits:fail "十六进制用 0-9 和 A-F" state))
      ((> (string-length t) 2) (bits:fail "一个字节的十六进制是两位，比如 FF" state))
      (#t
       (let ((n (string->number t 16)))
         (if (integer? n) (bits:set-number state n)
           (bits:fail "十六进制用 0-9 和 A-F" state)))))))

(define (bits:set-oct state raw)
  (let ((t (bits:strip-spaces raw)))
    (cond
      ((= (string-length t) 0) (bits:fail "八进制只用 0 到 7" state))
      ((> (string-length t) 3) (bits:fail "一个字节的八进制最多三位，比如 377" state))
      (#t
       (let ((n (string->number t 8)))
         (if (integer? n) (bits:set-number state n)
           (bits:fail "八进制只用 0 到 7" state)))))))

(define (bits:set-letter state ch)
  (let ((n (string-length ch)))
    (cond
      ((not (= n 1)) (bits:fail "只写一个字母" state))
      ((> (string-ref ch 0) 255)
       (bits:fail "汉字要好几个字节，这一课先记一个英文字母" state))
      (#t (bits:set-number state (string-ref ch 0))))))

(define (bits:chan state name)
  (cond
    ((equal? name "red") (bits:red state))
    ((equal? name "green") (bits:green state))
    ((equal? name "blue") (bits:blue state))
    (#t #f)))

(define (bits:set-chan state name value)
  (cond
    ((equal? name "red") (bits:ok (bits:copy state #f #f #f value #f #f #f)))
    ((equal? name "green") (bits:ok (bits:copy state #f #f #f #f value #f #f)))
    ((equal? name "blue") (bits:ok (bits:copy state #f #f #f #f #f value #f)))
    (#t (bits:fail "颜色只有红、绿、蓝" state))))

(define (bits:set-chan-number state name n msg)
  (if (not (integer? n))
    (bits:fail msg state)
    (if (or (< n 0) (> n 255))
      (bits:fail "写一个 0 到 255 的整数" state)
      (bits:set-chan state name n))))

(define (bits:hex-byte s)
  (let ((t (bits:strip-hex s)))
    (if (or (< (string-length t) 1) (> (string-length t) 2))
      #f
      (let ((n (string->number t 16)))
        (if (and (integer? n) (>= n 0) (<= n 255)) n #f)))))

(define (bits:fit-byte raw)
  (let ((s (bits:strip-spaces raw)))
    (if (and (> (string-length s) 0) (<= (string-length s) 8) (bits:only-bits? s))
      (bits:pad-left s 8 "0")
      #f)))

(define (bits:flip-chan state name index)
  (let ((cur (bits:chan state name)))
    (if (not (integer? cur))
      (bits:fail "颜色只有红、绿、蓝" state)
      (let ((n (bits:flip-bit cur 8 index)))
        (if (integer? n)
          (bits:set-chan state name n)
          (bits:fail "没有这一位" state))))))

(define (bits:do-flip state words)
  (let ((i (bits:nat (bits:word words 1) 10)))
    (if (not (integer? i))
      (bits:fail "没有这一张卡片" state)
      (let ((n (bits:flip-bit (bits:value state) (bits:width state) i)))
        (if (integer? n)
          (bits:ok (bits:copy state #f #f n #f #f #f #f))
          (bits:fail "没有这一张卡片" state))))))

(define (bits:do-set state words)
  (let ((kind (bits:word words 1)))
    (cond
      ((or (equal? kind "dec") (equal? kind "number"))
       (let ((n (bits:nat (bits:word words 2) 10)))
         (if (integer? n)
           (bits:set-number state n)
           (bits:fail "写一个 0 到 255 的整数" state))))
      ((or (equal? kind "bin") (equal? kind "bits"))
       (bits:set-bin state (bits:join-from words 2)))
      ((or (equal? kind "hex") (equal? kind "十六进制"))
       (bits:set-hex state (bits:join-from words 2)))
      ((or (equal? kind "oct") (equal? kind "八进制"))
       (bits:set-oct state (bits:join-from words 2)))
      ((or (equal? kind "letter") (equal? kind "字母"))
       (bits:set-letter state (bits:word words 2)))
      (#t (bits:fail "还不会这个动作" state)))))

(define (bits:do-chan state words)
  (let ((name (bits:word words 1)) (how (bits:word words 2)))
    (cond
      ((equal? how "flip")
       (let ((i (bits:nat (bits:word words 3) 10)))
         (if (integer? i)
           (bits:flip-chan state name i)
           (bits:fail "没有这一位" state))))
      ((equal? how "hex")
       (bits:set-chan-number state name (bits:hex-byte (bits:word words 3))
         "十六进制用 0-9 和 A-F"))
      ((equal? how "dec")
       (bits:set-chan-number state name (bits:nat (bits:word words 3) 10)
         "写一个 0 到 255 的整数"))
      ((equal? how "bin")
       (let ((s (bits:fit-byte (bits:word words 3))))
         (if (string? s)
           (bits:set-chan state name (string->number s 2))
           (bits:fail "要 8 个 0 或 1" state))))
      (#t (bits:fail "还不会这个动作" state)))))

(define (bits:do-color state words)
  (let ((raw (bits:strip-hex (bits:join-from words 1))))
    (if (not (= (string-length raw) 6))
      (bits:fail "颜色要 6 位十六进制，比如 FF0000" state)
      (let ((r (bits:hex-byte (substring raw 0 2)))
            (g (bits:hex-byte (substring raw 2 4)))
            (b (bits:hex-byte (substring raw 4 6))))
        (if (and (integer? r) (integer? g) (integer? b))
          (bits:ok (bits:copy state #f #f #f r g b #f))
          (bits:fail "十六进制用 0-9 和 A-F" state))))))

(define (bits:do-pix state words)
  (let ((r (bits:nat (bits:word words 1) 10))
        (c (bits:nat (bits:word words 2) 10)))
    (if (or (not (integer? r)) (not (integer? c)) (< r 0) (> r 7) (< c 0) (> c 7))
      (bits:fail "像素要在 8 乘 8 里面" state)
      (let ((n (bits:flip-bit (bits:nth (bits:rows state) r) 8 c)))
        (bits:ok (bits:copy state #f #f #f #f #f #f
                   (bits:set-nth (bits:rows state) r n)))))))

(define (bits:do-row state words)
  (let ((r (bits:nat (bits:word words 1) 10)) (how (bits:word words 2)))
    (if (or (not (integer? r)) (< r 0) (> r 7))
      (bits:fail "没有这一行" state)
      (cond
        ((equal? how "hex")
         (let ((n (bits:hex-byte (bits:word words 3))))
           (if (integer? n)
             (bits:ok (bits:copy state #f #f #f #f #f #f
                        (bits:set-nth (bits:rows state) r n)))
             (bits:fail "十六进制用 0-9 和 A-F" state))))
        ((equal? how "bin")
         (let ((s (bits:fit-byte (bits:join-from words 3))))
           (if (string? s)
             (bits:ok (bits:copy state #f #f #f #f #f #f
                        (bits:set-nth (bits:rows state) r (string->number s 2))))
             (bits:fail "一行要 8 个 0 或 1" state))))
        (#t (bits:fail "还不会这个动作" state))))))

(define (bits:do-stamp state words)
  (let ((rows (bits:stamp-rows (bits:word words 1))))
    (if (pair? rows)
      (bits:ok (bits:copy state #f #f #f #f #f #f rows))
      (bits:fail "没有这个图章" state))))

(define (bits:line state words)
  (let ((op (bits:word words 0)))
    (cond
      ((equal? op "flip") (bits:do-flip state words))
      ((equal? op "width")
       (let ((w (bits:nat (bits:word words 1) 10)))
         (if (integer? w) (bits:set-width state w)
           (bits:fail "宽度只能是 4、5 或 8" state))))
      ((equal? op "lamp")
       (let ((v (bits:nat (bits:word words 1) 10)))
         (if (and (integer? v) (or (= v 0) (= v 1)))
           (bits:ok (bits:copy state v #f #f #f #f #f #f))
           (bits:fail "开关只能是 0 或 1" state))))
      ((equal? op "set") (bits:do-set state words))
      ((equal? op "chan") (bits:do-chan state words))
      ((equal? op "color") (bits:do-color state words))
      ((equal? op "pix") (bits:do-pix state words))
      ((equal? op "row") (bits:do-row state words))
      ((equal? op "stamp") (bits:do-stamp state words))
      (#t (bits:fail "还不会这个动作" state)))))

(define (bits:split-lines s)
  (let ((n (string-length s)) (i 0) (start 0) (out (list)))
    (while (lambda () (< i n))
      (lambda ()
        (if (= (string-ref s i) 10)
          (begin
            (set! out (cons (bits:strip-cr (substring s start i)) out))
            (set! start (+ i 1))
            (set! i (+ i 1)))
          (set! i (+ i 1)))))
    (set! out (cons (bits:strip-cr (substring s start n)) out))
    (bits:reverse out)))

(define (bits:strip-cr s)
  (let ((n (string-length s)))
    (if (and (> n 0) (= (string-ref s (- n 1)) 13))
      (substring s 0 (- n 1))
      s)))

(define (bits:nonempty lines)
  (let ((out (list)) (p lines))
    (while (lambda () (pair? p))
      (lambda ()
        (if (> (string-length (car p)) 0) (set! out (cons (car p) out)))
        (set! p (cdr p))))
    (bits:reverse out)))

(define (bits:byte-bits s)
  (if (and (= (string-length s) 8) (bits:only-bits? s))
    (string->number s 2)
    #f))

(define (bits:rows-from-lines lines)
  (let ((out (list)) (p lines) (ok #t))
    (while (lambda () (and ok (pair? p)))
      (lambda ()
        (let ((v (bits:byte-bits (car p))))
          (if (integer? v)
            (begin (set! out (cons v out)) (set! p (cdr p)))
            (set! ok #f)))))
    (if ok (bits:reverse out) #f)))

(define (bits:rows-from-64 s)
  (if (and (= (string-length s) 64) (bits:only-bits? s))
    (let ((out (list)) (i 0))
      (while (lambda () (< i 64))
        (lambda ()
          (set! out (cons (string->number (substring s i (+ i 8)) 2) out))
          (set! i (+ i 8))))
      (bits:reverse out))
    #f))

(define (bits:parse-rows text)
  (let ((lines (bits:nonempty (bits:split-lines text))))
    (let ((n (bits:list-length lines)))
      (cond
        ((= n 8) (bits:rows-from-lines lines))
        ((= n 1) (bits:rows-from-64 (car lines)))
        (#t #f)))))

(define (bits:field src name)
  (let ((key (bits:cat (list "*" name "*")))
        (p (string-index src (bits:cat (list "*" name "*")) 0)))
    (if (< p 0) #f
      (let ((i (+ p (string-length key))) (n (string-length src)))
        (while (lambda () (and (< i n) (bits:space? (string-ref src i))))
          (lambda () (set! i (+ i 1))))
        (if (or (>= i n) (not (= (string-ref src i) 34)))
          #f
          (let ((j (+ i 1)))
            (while (lambda () (and (< j n) (not (= (string-ref src j) 34))))
              (lambda () (set! j (+ j 1))))
            (if (>= j n) #f (bits:unescape (substring src (+ i 1) j)))))))))

(define (bits:unescape-one d)
  (cond
    ((= d 110) (bits:ch 10))
    ((= d 114) (bits:ch 13))
    ((= d 116) (bits:ch 9))
    ((or (= d 34) (= d 92)) (bits:ch d))
    (#t #f)))

(define (bits:unescape s)
  (let ((n (string-length s)) (i 0) (out ""))
    (while (lambda () (< i n))
      (lambda ()
        (if (and (= (string-ref s i) 92) (< (+ i 1) n))
          (let ((one (bits:unescape-one (string-ref s (+ i 1)))))
            (if (string? one)
              (set! out (string-append out one))
              (set! out (string-append out (substring s i (+ i 2)))))
            (set! i (+ i 2)))
          (begin
            (set! out (string-append out (bits:ch (string-ref s i))))
            (set! i (+ i 1))))))
    out))

(define (bits:apply-fields state lamp width bits red green blue pixels)
  (let ((w (bits:nat width 10)))
    (cond
      ((not (or (equal? lamp "0") (equal? lamp "1")))
       (bits:fail "*lamp* 只能是 0 或 1" state))
      ((not (and (integer? w) (or (= w 4) (= w 5) (= w 8))))
       (bits:fail "*width* 只能是 4、5 或 8" state))
      ((not (bits:only-bits? bits))
       (bits:fail "*bits* 里只能写 0 和 1" state))
      ((not (= (string-length bits) w))
       (bits:fail "*bits* 的个数要和 *width* 一样" state))
      (#t
       (let ((rv (bits:byte-bits red))
             (gv (bits:byte-bits green))
             (bv (bits:byte-bits blue))
             (rows (bits:parse-rows pixels)))
         (cond
           ((not (integer? rv)) (bits:fail "*red* 要 8 个 0 或 1" state))
           ((not (integer? gv)) (bits:fail "*green* 要 8 个 0 或 1" state))
           ((not (integer? bv)) (bits:fail "*blue* 要 8 个 0 或 1" state))
           ((not (pair? rows)) (bits:fail "*pixels* 要 8 行，每行 8 个 0 或 1" state))
           (#t (bits:ok (list (if (equal? lamp "1") 1 0) w
                              (string->number bits 2) rv gv bv rows)))))))))

(define (bits:apply state src)
  (let ((lamp (bits:field src "lamp"))
        (width (bits:field src "width"))
        (bits (bits:field src "bits"))
        (red (bits:field src "red"))
        (green (bits:field src "green"))
        (blue (bits:field src "blue"))
        (pixels (bits:field src "pixels")))
    (cond
      ((not (string? lamp)) (bits:fail "程序里少了 *lamp*" state))
      ((not (string? width)) (bits:fail "程序里少了 *width*" state))
      ((not (string? bits)) (bits:fail "程序里少了 *bits*" state))
      ((not (string? red)) (bits:fail "程序里少了 *red*" state))
      ((not (string? green)) (bits:fail "程序里少了 *green*" state))
      ((not (string? blue)) (bits:fail "程序里少了 *blue*" state))
      ((not (string? pixels)) (bits:fail "程序里少了 *pixels*" state))
      (#t (bits:apply-fields state lamp width bits red green blue pixels)))))

(define (bits:command state text)
  (let ((raw (bits:trim text)))
    (cond
      ((equal? raw "") (bits:ok state))
      ((equal? raw "state") (bits:ok state))
      ((not (< (string-index raw "(define" 0) 0)) (bits:apply state raw))
      ((bits:starts-with? raw "apply") (bits:apply state raw))
      (#t (bits:line state (bits:words raw))))))

(define (bits:rows-text rows)
  (let ((out (list)) (p rows))
    (while (lambda () (pair? p))
      (lambda ()
        (set! out (cons (bits:from-int (car p) 8) out))
        (set! p (cdr p))))
    (bits:join (bits:reverse out) "\n")))

(define (bits:source state)
  (bits:cat (list
    ";; 果果的开关课 — 画面在读这些 0 和 1\n"
    "(define *lamp* \"" (if (= (bits:lamp state) 0) "0" "1") "\")\n"
    "(define *width* \"" (number->string (bits:width state)) "\")\n"
    "(define *bits* \"" (bits:from-int (bits:value state) (bits:width state)) "\")\n"
    "(define *red* \"" (bits:from-int (bits:red state) 8) "\")\n"
    "(define *green* \"" (bits:from-int (bits:green state) 8) "\")\n"
    "(define *blue* \"" (bits:from-int (bits:blue state) 8) "\")\n"
    "(define *pixels* \"" (bits:rows-text (bits:rows state)) "\")\n")))

(define (bits:json-string s)
  (let ((n (string-length s)) (i 0) (out "\""))
    (while (lambda () (< i n))
      (lambda ()
        (let ((c (string-ref s i)))
          (cond
            ((= c 34) (set! out (string-append out "\\\"")))
            ((= c 92) (set! out (string-append out "\\\\")))
            ((= c 10) (set! out (string-append out "\\n")))
            ((= c 13) (set! out (string-append out "\\r")))
            ((< c 32) (set! out (string-append out "?")))
            (#t (set! out (string-append out (bits:ch c)))))
          (set! i (+ i 1)))))
    (string-append out "\"")))

(define (bits:json-strings xs)
  (let ((out "[") (p xs) (first #t))
    (while (lambda () (pair? p))
      (lambda ()
        (if first (set! first #f) (set! out (string-append out ",")))
        (set! out (string-append out (bits:json-string (car p))))
        (set! p (cdr p))))
    (string-append out "]")))

(define (bits:json-pairs groups digits)
  (let ((out "[") (g groups) (d digits) (first #t))
    (while (lambda () (and (pair? g) (pair? d)))
      (lambda ()
        (if first (set! first #f) (set! out (string-append out ",")))
        (set! out (bits:cat (list out "{\"bits\":" (bits:json-string (car g))
                                  ",\"digit\":" (bits:json-string (car d)) "}")))
        (set! g (cdr g))
        (set! d (cdr d))))
    (string-append out "]")))

(define (bits:row-bits rows)
  (let ((out (list)) (p rows))
    (while (lambda () (pair? p))
      (lambda ()
        (set! out (cons (bits:from-int (car p) 8) out))
        (set! p (cdr p))))
    (bits:reverse out)))

(define (bits:row-hexes rows)
  (let ((out (list)) (p rows))
    (while (lambda () (pair? p))
      (lambda ()
        (set! out (cons (bits:hex (car p) 8) out))
        (set! p (cdr p))))
    (bits:reverse out)))

(define (bits:color state)
  (bits:cat (list "#" (bits:hex (bits:red state) 8)
                  (bits:hex (bits:green state) 8)
                  (bits:hex (bits:blue state) 8))))

(define (bits:json-nodes nodes)
  (let ((out "[") (p nodes) (first #t))
    (while (lambda () (pair? p))
      (lambda ()
        (let ((row (car p)))
          (if first
            (set! first #f)
            (set! out (string-append out ",")))
          (set! out (bits:cat (list out
            "{\"name\":" (bits:json-string (bits:nth row 0))
            ",\"define\":" (number->string (bits:nth row 1))
            ",\"literal\":" (number->string (bits:nth row 2))
            ",\"text\":" (bits:json-string (bits:nth row 3))
            ",\"changed\":" (if (= (bits:nth row 4) 1) "true" "false")
            "}"))))
        (set! p (cdr p))))
    (string-append out "]")))

(define (bits:json state ok? err note)
  (bits:json-view state ok? err note (bits:source state) (bits:source state) "" (list)))

(define (bits:json-view state ok? err note source workspace mut nodes)
  (let ((w (bits:width state)) (v (bits:value state)))
    (let ((b (bits:from-int v w))
          (hg (bits:groups-right b 4))
          (og (bits:groups-right b 3))
          (rows (bits:rows state)))
      (bits:cat (list
        "{"
        (bits:join (list
          (bits:cat (list "\"ok\":" (if (equal? ok? #t) "true" "false")))
          (bits:cat (list "\"error\":" (bits:json-string err)))
          (bits:cat (list "\"note\":" (bits:json-string note)))
          (bits:cat (list "\"lamp\":" (number->string (bits:lamp state))))
          (bits:cat (list "\"width\":" (number->string w)))
          (bits:cat (list "\"dec\":" (number->string v)))
          (bits:cat (list "\"bits\":" (bits:json-string b)))
          (bits:cat (list "\"hex\":" (bits:json-string (bits:hex v w))))
          (bits:cat (list "\"oct\":" (bits:json-string (bits:oct v w))))
          (bits:cat (list "\"hexGrouped\":" (bits:json-string (bits:join (car hg) " "))))
          (bits:cat (list "\"octGrouped\":" (bits:json-string (bits:join (car og) " "))))
          (bits:cat (list "\"letter\":" (bits:json-string (bits:letter v))))
          (bits:cat (list "\"letterNote\":" (bits:json-string (bits:letter-note v w))))
          (bits:cat (list "\"red\":" (number->string (bits:red state))))
          (bits:cat (list "\"green\":" (number->string (bits:green state))))
          (bits:cat (list "\"blue\":" (number->string (bits:blue state))))
          (bits:cat (list "\"redBits\":" (bits:json-string (bits:from-int (bits:red state) 8))))
          (bits:cat (list "\"greenBits\":" (bits:json-string (bits:from-int (bits:green state) 8))))
          (bits:cat (list "\"blueBits\":" (bits:json-string (bits:from-int (bits:blue state) 8))))
          (bits:cat (list "\"redHex\":" (bits:json-string (bits:hex (bits:red state) 8))))
          (bits:cat (list "\"greenHex\":" (bits:json-string (bits:hex (bits:green state) 8))))
          (bits:cat (list "\"blueHex\":" (bits:json-string (bits:hex (bits:blue state) 8))))
          (bits:cat (list "\"color\":" (bits:json-string (bits:color state))))
          (bits:cat (list "\"rows\":" (bits:json-strings (bits:row-bits rows))))
          (bits:cat (list "\"rowHex\":" (bits:json-strings (bits:row-hexes rows))))
          (bits:cat (list "\"hexChunks\":" (bits:json-pairs (car hg) (cdr hg))))
          (bits:cat (list "\"octChunks\":" (bits:json-pairs (car og) (cdr og))))
          (bits:cat (list "\"source\":" (bits:json-string source)))
          (bits:cat (list "\"workspace\":" (bits:json-string workspace)))
          (bits:cat (list "\"mut\":" (bits:json-string mut)))
          (bits:cat (list "\"nodes\":" (bits:json-nodes nodes))))
          ",")
        "}")))))
