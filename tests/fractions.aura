; 分数课的命令和工作区。不打开网络。
(require "aura/bits" all:)
(require "aura/fractions" all:)

(define *fails* 0)

(define (expect name got want)
  (if (equal? got want)
    #t
    (begin
      (set! *fails* (+ *fails* 1))
      (display "FAIL ")
      (display name)
      (display " / got ")
      (display got)
      (display " / want ")
      (display want)
      (newline))))

(define (quad st)
  (list (bits:nth st 0) (bits:nth st 1) (bits:nth st 2) (bits:nth st 3)))

(define (def-id name) (car (query :find name)))

(define (lit-id name)
  (car (query :children (def-id name))))

(define (lit-text name)
  (let ((node (query :node (lit-id name))))
    (car (cdr node))))

(define (has text key)
  (and (string? text) (not (= (string-index text key 0) -1))))

(define fresh (fr:fresh))
(expect "fresh" (quad fresh) (list 1 2 1 3))

(define view (fr:json-view fresh #t "" "" "" "" "" (list)))
(expect "quot" (has view "\"quot\":0") #t)
(expect "sum num" (has view "\"sumNum\":5") #t)
(expect "sum den" (has view "\"sumDen\":6") #t)
(expect "sum ok" (has view "\"sumOk\":true") #t)
(expect "diff num" (has view "\"diffNum\":1") #t)
(expect "diff den" (has view "\"diffDen\":6") #t)
(expect "diff ok" (has view "\"diffOk\":true") #t)
(expect "same num" (has view "\"sameNum\":3") #t)
(expect "same den" (has view "\"sameDen\":6") #t)
(expect "same num2" (has view "\"sameNum2\":2") #t)
(expect "same ok" (has view "\"sameOk\":true") #t)
(expect "sum whole" (has view "\"sumWhole\":0") #t)
(expect "sum rest" (has view "\"sumRest\":5") #t)

(define samed (fr:command fresh "same"))
(expect "same ok" (bits:ok? samed) #t)
(expect "same" (quad (bits:result samed)) (list 3 6 2 6))

(define added (fr:command (bits:result samed) "add"))
(expect "add ok" (bits:ok? added) #t)
(expect "add kept" (quad (bits:result added)) (list 3 6 2 6))

(define subtracted (fr:command fresh "sub"))
(expect "sub ok" (bits:ok? subtracted) #t)
(expect "sub kept" (quad (bits:result subtracted)) (list 1 2 1 3))

(define bigger (fr:command fresh "take2 2"))
(define cannot (fr:command (bits:result bigger) "sub"))
(expect "sub too big" (bits:ok? cannot) #f)
(expect "sub too big kept" (quad (bits:result cannot)) (list 1 2 2 3))
(expect "sub too big msg" (bits:error cannot) "减掉的比第一条多。这课先不画负的")
(define big-view (fr:json-view (bits:result cannot) #f "" "" "" "" "" (list)))
(expect "big same num" (has big-view "\"sameNum\":3") #t)
(expect "big same den" (has big-view "\"sameDen\":6") #t)
(expect "big same num2" (has big-view "\"sameNum2\":4") #t)
(expect "big same ok" (has big-view "\"sameOk\":true") #t)
(expect "big diff ok" (has big-view "\"diffOk\":false") #t)

(define past-one
  (bits:result (fr:command
    (bits:result (fr:command
      (bits:result (fr:command fresh "cut 4"))
      "take 3"))
    "take2 2")))
(expect "past one" (quad past-one) (list 3 4 2 3))
(define past-add (fr:command past-one "add"))
(expect "past add" (bits:ok? past-add) #t)
(expect "past kept" (quad (bits:result past-add)) (list 3 4 2 3))
(define past-view (fr:json-view past-one #t "" "" "" "" "" (list)))
(expect "past sum" (has past-view "\"sumNum\":17") #t)
(expect "past den" (has past-view "\"sumDen\":12") #t)
(expect "past whole" (has past-view "\"sumWhole\":1") #t)
(expect "past rest" (has past-view "\"sumRest\":5") #t)
(expect "past same" (has past-view "\"sameNum\":9") #t)
(expect "past same2" (has past-view "\"sameNum2\":8") #t)

(define wide
  (bits:result (fr:command
    (bits:result (fr:command fresh "cut 13"))
    "cut2 17")))
(expect "wide" (quad wide) (list 1 13 1 17))
(expect "wide same" (bits:ok? (fr:command wide "same")) #f)
(expect "wide add" (bits:ok? (fr:command wide "add")) #t)
(expect "wide kept" (quad (bits:result (fr:command wide "add"))) (list 1 13 1 17))
(expect "wide sub" (bits:ok? (fr:command wide "sub")) #t)
(expect "wide sub kept" (quad (bits:result (fr:command wide "sub"))) (list 1 13 1 17))
(define wide-view (fr:json-view wide #t "" "" "" "" "" (list)))
(expect "wide ok" (has wide-view "\"sameOk\":false") #t)
(expect "wide den" (has wide-view "\"sameDen\":221") #t)
(expect "wide num" (has wide-view "\"sameNum\":17") #t)
(expect "wide num2" (has wide-view "\"sameNum2\":13") #t)
(expect "wide sum" (has wide-view "\"sumNum\":30") #t)
(expect "wide sum den" (has wide-view "\"sumDen\":221") #t)
(expect "wide whole" (has wide-view "\"sumWhole\":0") #t)
(expect "wide rest" (has wide-view "\"sumRest\":30") #t)
(expect "wide diff" (has wide-view "\"diffNum\":4") #t)
(expect "wide diff den" (has wide-view "\"diffDen\":221") #t)
(expect "wide diff ok" (has wide-view "\"diffOk\":true") #t)

(define wide-back
  (bits:result (fr:command
    (bits:result (fr:command fresh "cut 17"))
    "cut2 13")))
(expect "wide back" (quad wide-back) (list 1 17 1 13))
(define wide-back-sub (fr:command wide-back "sub"))
(expect "wide back sub" (bits:ok? wide-back-sub) #f)
(expect "wide back kept" (quad (bits:result wide-back-sub)) (list 1 17 1 13))
(expect "wide back msg" (bits:error wide-back-sub) "减掉的比第一条多。这课先不画负的")
(define wide-back-view (fr:json-view wide-back #f "" "" "" "" "" (list)))
(expect "wide back diff" (has wide-back-view "\"diffOk\":false") #t)
(expect "wide back num" (has wide-back-view "\"sameNum\":13") #t)
(expect "wide back num2" (has wide-back-view "\"sameNum2\":17") #t)

(define both
  (bits:result (fr:command
    (bits:result (fr:command
      (bits:result (fr:command
        (bits:result (fr:command fresh "cut 13"))
        "take 12"))
      "cut2 17"))
    "take2 16")))
(expect "both" (quad both) (list 12 13 16 17))
(expect "both add" (bits:ok? (fr:command both "add")) #t)
(define both-view (fr:json-view both #t "" "" "" "" "" (list)))
(expect "both sum" (has both-view "\"sumNum\":412") #t)
(expect "both den" (has both-view "\"sumDen\":221") #t)
(expect "both whole" (has both-view "\"sumWhole\":1") #t)
(expect "both rest" (has both-view "\"sumRest\":191") #t)
(expect "both same" (has both-view "\"sameNum\":204") #t)
(expect "both same2" (has both-view "\"sameNum2\":208") #t)

(define cut (fr:command fresh "cut 4"))
(expect "cut" (quad (bits:result cut)) (list 1 4 1 3))
(define took (fr:command (bits:result cut) "take 3"))
(expect "take" (quad (bits:result took)) (list 3 4 1 3))
(define finer (fr:command (bits:result took) "finer"))
(expect "finer" (quad (bits:result finer)) (list 6 8 1 3))
(define reduced (fr:command (bits:result finer) "reduce"))
(expect "reduce" (quad (bits:result reduced)) (list 3 4 1 3))

(define zero (fr:command fresh "cut 0"))
(expect "cut 0" (bits:ok? zero) #f)
(expect "cut 0 kept" (quad (bits:result zero)) (list 1 2 1 3))
(expect "cut 0 msg" (bits:error zero) "分母要在 1 和 24 之间")

(define huge (fr:command fresh "cut 25"))
(expect "cut 25" (bits:ok? huge) #f)
(expect "cut 25 kept" (quad (bits:result huge)) (list 1 2 1 3))

(define past (fr:command fresh "take 3"))
(expect "take three" (bits:ok? past) #t)
(expect "take three kept" (quad (bits:result past)) (list 3 2 1 3))
(define too-many (fr:command fresh "take 25"))
(expect "take 25" (bits:ok? too-many) #f)
(expect "take 25 kept" (quad (bits:result too-many)) (list 1 2 1 3))
(expect "take 25 msg" (bits:error too-many) "拿走的份数要在 0 和 24 之间")

(define four
  (bits:result (fr:command
    (bits:result (fr:command fresh "cut 3"))
    "take 4")))
(expect "four thirds" (quad four) (list 4 3 1 3))
(expect "cut under" (quad (bits:result (fr:command four "cut 2"))) (list 4 2 1 3))
(define mixed
  (bits:result (fr:command
    (bits:result (fr:command four "cut2 4"))
    "take2 5")))
(expect "mixed" (quad mixed) (list 4 3 5 4))
(expect "mixed add" (bits:ok? (fr:command mixed "add")) #t)
(expect "mixed sub" (bits:ok? (fr:command mixed "sub")) #t)
(expect "mixed kept" (quad (bits:result (fr:command mixed "add"))) (list 4 3 5 4))
(define mixed-view (fr:json-view mixed #t "" "" "" "" "" (list)))
(expect "mixed sum" (has mixed-view "\"sumNum\":31") #t)
(expect "mixed den" (has mixed-view "\"sumDen\":12") #t)
(expect "mixed whole" (has mixed-view "\"sumWhole\":2") #t)
(expect "mixed rest" (has mixed-view "\"sumRest\":7") #t)
(expect "mixed same" (has mixed-view "\"sameNum\":16") #t)
(expect "mixed same2" (has mixed-view "\"sameNum2\":15") #t)
(expect "mixed diff" (has mixed-view "\"diffNum\":1") #t)
(expect "mixed diff den" (has mixed-view "\"diffDen\":12") #t)
(expect "mixed bars" (has mixed-view "\"whole\":1") #t)
(expect "mixed bars rest" (has mixed-view "\"rest\":1") #t)
(expect "mixed bars2" (has mixed-view "\"whole2\":1") #t)
(expect "mixed bars2 rest" (has mixed-view "\"rest2\":1") #t)
(define other
  (bits:result (fr:command
    (bits:result (fr:command
      (bits:result (fr:command fresh "cut 4"))
      "take 5"))
    "cut2 3")))
(define other2 (bits:result (fr:command other "take2 4")))
(expect "other" (quad other2) (list 5 4 4 3))
(expect "other sub" (bits:ok? (fr:command other2 "sub")) #f)
(expect "other kept" (quad (bits:result (fr:command other2 "sub"))) (list 5 4 4 3))
(define heavy
  (bits:result (fr:command
    (bits:result (fr:command fresh "cut 7"))
    "take 13")))
(expect "heavy finer" (bits:ok? (fr:command heavy "finer")) #f)
(expect "heavy kept" (quad (bits:result (fr:command heavy "finer"))) (list 13 7 1 3))

(if (not (equal? (fr:install! "aura/fraction-seed.aura") #t))
  (begin (display "FRACTION_FAIL pin\n") (exit 1)))

(expect "pinned" (quad (fr:state)) (list 1 2 1 3))
(expect "seed num" (lit-text "*num*") "1")
(define num-lit (lit-id "*num*"))
(define num-def (def-id "*num*"))
(define den-lit (lit-id "*den*"))
(define den-def (def-id "*den*"))

(define before (current-source :workspace))
(define step (fr:command (fr:state) "finer"))
(define wrote (fr:commit! (bits:result step)))
(expect "batch" (has wrote "atomic-batch") #t)
(expect "finer num" (lit-text "*num*") "2")
(expect "finer den" (lit-text "*den*") "4")
(expect "finer num2" (lit-text "*num2*") "1")
(expect "same num lit" (lit-id "*num*") num-lit)
(expect "same num def" (def-id "*num*") num-def)
(expect "same den lit" (lit-id "*den*") den-lit)
(expect "same den def" (def-id "*den*") den-def)
(expect "source moved" (equal? before (current-source :workspace)) #f)

(define took-one (fr:command (fr:state) "take 1"))
(define wrote-one (fr:commit! (bits:result took-one)))
(expect "one verb" (has wrote-one "replace-value") #t)
(expect "took num" (lit-text "*num*") "1")
(expect "took den" (lit-text "*den*") "4")
(expect "took lit" (lit-id "*num*") num-lit)
(expect "took def" (def-id "*num*") num-def)

(define frozen (current-source :workspace))
(define bad (fr:command (fr:state) "take 25"))
(expect "bad" (bits:ok? bad) #f)
(expect "bad still" (equal? frozen (current-source :workspace)) #t)
(expect "bad num" (lit-text "*num*") "1")
(expect "bad commit" (fr:commit! (bits:result bad)) "")
(expect "bad after" (equal? frozen (current-source :workspace)) #t)

(if (= *fails* 0)
  (begin (display "FRACTION_OK\n") (exit 0))
  (begin
    (display "FRACTION_FAIL ")
    (display *fails*)
    (newline)
    (exit 1)))
